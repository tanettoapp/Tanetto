<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 1.0.8 (sicurezza), allowBackup="true" lasciato apposta: il backup automatico di Google e il passaggio a un
         telefono nuovo salvano il compagno anche a chi non usa l'account. Con targetSdk 31+ "adb backup" non copia
         piu' i dati dell'app sui telefoni Android 12+ (fino ad Android 11 si', ma serve un computer e modificare il
         database del WebView: come avere i permessi di root). Un salvataggio rimesso sul telefono passa comunque dai
         controlli dell'avvio (45z_v20_secboot.js) e Plus viene riconfermato da Google Play.
         Niente usesCleartextTraffic (vietato per default), nessun deep link, una sola attivita' esportata. -->
    <!-- 1.0.11 (G-14/H-08): regole esplicite del backup automatico di Google: torna il compagno (memoria locale del
         WebView) e il widget; NON tornano la sessione di Firebase (si rientra nell'account), le cache e le scelte sulla
         pubblicita' (il consenso si richiede sul telefono nuovo). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- 1.0.8: nessun blocco dell'orientamento (si gira come vuole chi la usa, rispettando il blocco
             rotazione del telefono) e finestra ridimensionabile: schermo diviso, finestre libere su
             Chromebook e tablet, pieghevoli. configChanges completi: girando o piegando non si riavvia. -->
        <activity
            android:resizeableActivity="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget della schermata Home -->
        <receiver
            android:name=".TanettoWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-4252103380033748~4062639058"/>
    </application>

    <!-- 1.0.8: l'app si usa anche con mouse e tastiera (Chromebook senza schermo touch):
         senza questa riga Google Play la nasconderebbe su quei dispositivi -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- I promemoria non hanno bisogno di orari al secondo: niente permesso "sveglie esatte" -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <!-- Non usiamo impronta digitale o riconoscimento del volto: si tolgono i permessi aggiunti dalle librerie -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    <!-- 1.0.11 (A-01): la vibrazione leggera dei tocchi (interruttore in Impostazioni) senza questo permesso non funzionava mai.
         E' un permesso "normale": nessuna richiesta a chi usa l'app. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 1.0.11 (H-07): non servono (API di Privacy Sandbox per la pubblicita' e servizio in primo piano di WorkManager, mai usato):
         in un'app anche per bambini si tolgono -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
</manifest>
